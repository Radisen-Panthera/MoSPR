@@ -1,3 +1,4 @@
+import os as _os_tv
 from pathlib import Path
 import pickle
 
@@ -50,7 +51,11 @@
 
         if args.resolution == "":
             args.resolution = "fine"
-        with open(f"{data_dir}/{args.fold}/{args.resolution}_parameter_dict.pkl", "rb") as f:
+        # CPNN_C2L_PREFIX: prefix of the cell2location output folder; "" means {fold}.
+        # A patient-level split has different folds, so a parameter_dict built on the
