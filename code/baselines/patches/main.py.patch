+    # -- seeding ------------------------------------------------------------
+    # Upstream defines utils.fix_seed but never calls it, so repeating a run
+    # changes where early stopping lands (measured: mean-pool BRCA fold0 over
+    # three runs gave SCC 0.2036 / 0.2379 / 0.2398, a range of 0.036).
+    # Reproducible tables require that variance to be removed.
+    # CPNN_SEED overrides it; the default is GENERAL.seed (2021) from config.
+    import os as _os
+    import random as _random
+    import numpy as _np
+    import torch as _torch
+    _seed = int(_os.environ.get("CPNN_SEED", 2021))
+
+    # PYTHONHASHSEED only takes effect at interpreter start, so the launcher must
+    # export it. Here we only check and warn.
+    if _os.environ.get("PYTHONHASHSEED") != str(_seed):
+        print(f"[seed] warning: PYTHONHASHSEED unset (recommended: export PYTHONHASHSEED={_seed})", flush=True)
+
+    fix_seed(_seed)                            # random / numpy / torch / cuda / cudnn
+    pl.seed_everything(_seed, workers=True)    # including dataloader workers
+    _random.seed(_seed); _np.random.seed(_seed)
+    _torch.manual_seed(_seed); _torch.cuda.manual_seed_all(_seed)
+    _torch.backends.cudnn.deterministic = True
